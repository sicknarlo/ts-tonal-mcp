{
  "name": "@dlwiest/ts-tonal-mcp",
  "version": "0.6.0",
  "description": "MCP server for Tonal fitness data integration",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json && tsc -p tsconfig.worker.json",
    "dev:worker": "wrangler dev",
    "deploy": "wrangler deploy"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dlwiest/ts-tonal-mcp.git"
  },
  "keywords": [
    "mcp",
    "tonal",
    "fitness",
    "llm",
    "claude"
  ],
  "author": "dlwiest",
  "license": "ISC",
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@dlwiest/ts-tonal-client": "^0.6.0",
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261008.1",
    "@types/node": "^20.14.8",
    "tsx": "^4.20.6",
    "typescript": "^5.5.4",
    "wrangler": "^4.148.0"
  }
}
